{
  "expo": {
    "name": "Setlist Ultra",
    "slug": "setlist-ultra",
    "version": "0.3.3",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "setlistultra",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.setlistultra.app",
      "infoPlist": {
        "LSSupportsOpeningDocumentsInPlace": false,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Setlist Ultra chart",
            "LSHandlerRank": "Owner",
            "CFBundleTypeRole": "Editor",
            "LSItemContentTypes": [
              "com.setlistultra.sbp",
              "public.zip-archive",
              "public.plain-text",
              "public.data"
            ]
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.setlistultra.sbp",
            "UTTypeDescription": "Songbook Pro set",
            "UTTypeConformsTo": ["public.data", "public.zip-archive"],
            "UTTypeTagSpecification": {
              "public.filename-extension": ["sbp", "sbpbackup"],
              "public.mime-type": ["application/zip", "application/octet-stream"]
            }
          }
        ]
      }
    },
    "android": {
      "package": "com.setlistultra.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["DEFAULT", "BROWSABLE"],
          "data": [
            { "scheme": "content", "mimeType": "application/octet-stream" },
            { "scheme": "content", "mimeType": "application/zip" },
            { "scheme": "content", "mimeType": "text/plain" },
            { "scheme": "file", "pathPattern": ".*\\\\.sbp" },
            { "scheme": "file", "pathPattern": ".*\\\\.sbpbackup" },
            { "scheme": "file", "pathPattern": ".*\\\\.cho" },
            { "scheme": "file", "pathPattern": ".*\\\\.chopro" },
            { "scheme": "file", "pathPattern": ".*\\\\.crd" }
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Scan paper charts into your library.",
          "cameraPermission": "Scan paper charts into your library."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 180,
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#FFFFFF"
          }
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsFileWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          },
          "androidIntentFilters": [
            "*/*",
            "application/zip",
            "application/octet-stream",
            "text/plain"
          ]
        }
      ],
      "expo-sharing",
      "expo-font",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "googleWebClientId": "${EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID}",
      "googleAndroidClientId": "${EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID}",
      "ugProxyUrl": "https://ug.bigzay.com",
      "supabaseUrl": "${EXPO_PUBLIC_SUPABASE_URL}",
      "supabaseAnonKey": "${EXPO_PUBLIC_SUPABASE_ANON_KEY}",
      "managerUrl": "${EXPO_PUBLIC_MANAGER_URL}",
      "webAppUrl": "${EXPO_PUBLIC_WEB_APP_URL}",
      "router": {},
      "eas": {
        "projectId": "6d749cfe-0b5d-441c-be35-941a500dcbae"
      }
    },
    "owner": "zayyo"
  }
}
