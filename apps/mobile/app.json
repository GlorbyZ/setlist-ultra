{
  "expo": {
    "name": "Setlist Ultra",
    "slug": "setlist-ultra",
    "version": "5.0.9",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "setlistultra",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.setlistultra.app",
      "infoPlist": {
        "LSSupportsOpeningDocumentsInPlace": false,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Setlist Ultra chart",
            "LSHandlerRank": "Owner",
            "CFBundleTypeRole": "Editor",
            "LSItemContentTypes": [
              "com.setlistultra.sbp",
              "public.zip-archive",
              "public.plain-text",
              "public.data"
            ]
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.setlistultra.sbp",
            "UTTypeDescription": "Songbook Pro set",
            "UTTypeConformsTo": [
              "public.data",
              "public.zip-archive"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "sbp",
                "sbpbackup"
              ],
              "public.mime-type": [
                "application/zip",
                "application/octet-stream"
              ]
            }
          }
        ]
      },
      "buildNumber": "47"
    },
    "android": {
      "package": "com.setlistultra.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "SEND",
          "category": ["DEFAULT"],
          "data": [
            { "mimeType": "*/*" },
            { "mimeType": "application/zip" },
            { "mimeType": "application/x-zip" },
            { "mimeType": "application/x-zip-compressed" },
            { "mimeType": "application/octet-stream" },
            { "mimeType": "application/pdf" },
            { "mimeType": "text/*" }
          ]
        },
        {
          "action": "VIEW",
          "category": ["DEFAULT", "BROWSABLE"],
          "data": [
            { "scheme": "content", "mimeType": "application/octet-stream" },
            { "scheme": "content", "mimeType": "application/zip" },
            { "scheme": "content", "mimeType": "application/x-zip" },
            { "scheme": "content", "mimeType": "application/x-zip-compressed" },
            { "scheme": "content", "mimeType": "application/pdf" },
            { "scheme": "content", "mimeType": "text/plain" },
            { "scheme": "content", "mimeType": "text/*" },
            { "scheme": "file", "mimeType": "application/octet-stream" },
            { "scheme": "file", "mimeType": "application/zip" },
            { "scheme": "file", "mimeType": "application/x-zip" },
            { "scheme": "file", "mimeType": "application/x-zip-compressed" },
            { "scheme": "file", "mimeType": "application/pdf" },
            { "scheme": "file", "mimeType": "text/plain" },
            { "scheme": "file", "mimeType": "text/*" }
          ]
        },
        {
          "action": "VIEW",
          "category": ["DEFAULT", "BROWSABLE"],
          "data": [
            { "scheme": "content", "host": "*", "mimeType": "*/*", "pathPattern": ".*\\\\.pdf" },
            { "scheme": "content", "host": "*", "mimeType": "*/*", "pathPattern": ".*\\\\.sbp" },
            { "scheme": "content", "host": "*", "mimeType": "*/*", "pathPattern": ".*\\\\.sbpbackup" },
            { "scheme": "content", "host": "*", "mimeType": "*/*", "pathPattern": ".*\\\\.cho" },
            { "scheme": "content", "host": "*", "mimeType": "*/*", "pathPattern": ".*\\\\.chopro" },
            { "scheme": "content", "host": "*", "mimeType": "*/*", "pathPattern": ".*\\\\.crd" },
            { "scheme": "content", "host": "*", "mimeType": "*/*", "pathPattern": ".*\\\\.onsong" },
            { "scheme": "content", "host": "*", "mimeType": "*/*", "pathPattern": ".*\\\\.pro" },
            { "scheme": "content", "host": "*", "mimeType": "*/*", "pathPattern": ".*\\\\.txt" },
            { "scheme": "content", "host": "*", "mimeType": "*/*", "pathPattern": ".*\\\\.zip" },
            { "scheme": "file", "host": "*", "mimeType": "*/*", "pathPattern": ".*\\\\.pdf" },
            { "scheme": "file", "host": "*", "mimeType": "*/*", "pathPattern": ".*\\\\.sbp" },
            { "scheme": "file", "host": "*", "mimeType": "*/*", "pathPattern": ".*\\\\.sbpbackup" },
            { "scheme": "file", "host": "*", "mimeType": "*/*", "pathPattern": ".*\\\\.cho" },
            { "scheme": "file", "host": "*", "mimeType": "*/*", "pathPattern": ".*\\\\.chopro" },
            { "scheme": "file", "host": "*", "mimeType": "*/*", "pathPattern": ".*\\\\.crd" },
            { "scheme": "file", "host": "*", "mimeType": "*/*", "pathPattern": ".*\\\\.onsong" },
            { "scheme": "file", "host": "*", "mimeType": "*/*", "pathPattern": ".*\\\\.pro" },
            { "scheme": "file", "host": "*", "mimeType": "*/*", "pathPattern": ".*\\\\.txt" },
            { "scheme": "file", "host": "*", "mimeType": "*/*", "pathPattern": ".*\\\\.zip" }
          ]
        }
      ],
      "versionCode": 66
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Scan paper charts into your library.",
          "cameraPermission": "Scan paper charts into your library."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 180,
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsFileWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1
          },
          "androidIntentFilters": [
            "*/*",
            "application/zip",
            "application/x-zip",
            "application/x-zip-compressed",
            "application/octet-stream",
            "text/*",
            "application/pdf"
          ]
        }
      ],
      "expo-sharing",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "googleWebClientId": "",
      "googleAndroidClientId": "",
      "ugProxyUrl": "https://ug.bigzay.com",
      "aiGatewayUrl": "https://ai.bigzay.com",
      "aiGatewayToken": "",
      "supabaseUrl": "",
      "supabaseAnonKey": "",
      "managerUrl": "",
      "webAppUrl": "",
      "privacyPolicyUrl": "",
      "supportEmail": "epicnigs3@gmail.com",
      "launchAi": "1",
      "launchScan": "",
      "launchAudio": "1",
      "router": {},
      "eas": {
        "projectId": "6d749cfe-0b5d-441c-be35-941a500dcbae"
      }
    },
    "owner": "zayyo"
  }
}
