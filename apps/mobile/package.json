{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "preflight": "powershell -ExecutionPolicy Bypass -File ./scripts/preflight.ps1",
    "start": "powershell -ExecutionPolicy Bypass -File ./scripts/preflight.ps1 && expo start",
    "start:clear": "powershell -ExecutionPolicy Bypass -File ./scripts/preflight.ps1 && expo start --clear",
    "android": "expo run:android",
    "android:apk": "powershell -ExecutionPolicy Bypass -File ./scripts/build-android.ps1",
    "android:apk:debug": "powershell -ExecutionPolicy Bypass -File ./scripts/build-android.ps1 --debug",
    "verify:apk": "powershell -ExecutionPolicy Bypass -File ./scripts/verify-apk.ps1 -ApkPath ../../releases/setlist-ultra-android.apk",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:export": "expo export --platform web --output-dir dist/web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@setlist-ultra/api": "*",
    "@setlist-ultra/core": "*",
    "@setlist-ultra/db": "*",
    "babel-preset-expo": "~57.0.0",
    "drizzle-orm": "^0.44.2",
    "expo": "~57.0.20",
    "expo-auth-session": "~57.0.11",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-print": "~57.0.1",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
