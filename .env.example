# Google OAuth (https://console.cloud.google.com/)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# UG import proxy. Production APKs use the hosted Worker.
# Local: npm run ug-proxy  then  EXPO_PUBLIC_UG_PROXY_URL=http://localhost:8787
EXPO_PUBLIC_UG_PROXY_URL=https://ug.bigzay.com

# Optional hosted catalog (see services/api/README.md)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional LAN Manager (npm run manager)
EXPO_PUBLIC_MANAGER_URL=http://localhost:3848
EXPO_PUBLIC_WEB_APP_URL=
